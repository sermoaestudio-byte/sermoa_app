# Configuración de Supabase para Sermoa Studio
# Encuentra estos valores en: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# Mercado Pago (Solo Public Key, el Access Token va exclusivamente en Supabase Secrets)
VITE_MERCADO_PAGO_PUBLIC_KEY=tu-public-key-de-mercado-pago-aqui
